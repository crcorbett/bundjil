un --conditions=@bundjil/source run scripts/generate-adoption-manifest.ts\",\n    \"adoption:re-admit\": \"bun --conditions=@bundjil/source run scripts/re-admit-adoption-manifest.ts\",\n    \"adoption:proof\": \"bun --conditions=@bundjil/source run scripts/prove-adoption-state.ts\",\n    \"photon:bind-preview-webhook\": \"bun --conditions=@bundjil/source run scripts/bind-photon-preview-webhook.ts\",\n    \"inventory:live\": \"bun --conditions=@bundjil/source run scripts/inventory-live.ts\",\n    \"preview:drift\": \"bun --conditions=@bundjil/source run scripts/preview-configuration-drift.ts\",\n    \"production:deploy\": \"bun --conditions=@bundjil/source run scripts/automatic-production.ts\",\n    \"report:drift\": \"bun --conditions=@bundjil/source run scripts/report-drift.ts\",\n    \"vercel:git-link-authority\": \"bun --conditions=@bundjil/source run scripts/validate-vercel-git-link-authority.ts\",\n    \"test\": \"vitest run && bun --conditions=@bundjil/source test test-alchemy\"\n  },\n  \"dependencies\": {\n    \"@bundjil/photon\": \"workspace:*\",\n    \"@distilled.cloud/aws\": \"0.30.1\",\n    \"@effect/platform-bun\": \"catalog:effect\",\n    \"ajv\": \"^8.17.1\",\n    \"alchemy\": \"2.0.0-beta.64\",\n    \"effect\": \"catalog:effect\"\n  },\n  \"devDependencies\": {\n    \"@effect/vitest\": \"catalog:effect\",\n    \"@types/bun\": \"^1.3.14\",\n    \"bun-types\": \"1.3.14\",\n    \"typescript\": \"catalog:typescript\",\n    \"vitest\": \"catalog:testing\"\n  }\n}\n","stderr":"","aggregated_output":"{\n  \"name\": \"@bundjil/infrastructure\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Private Alchemy infrastructure contracts and providers for Bundjil.\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/crcorbett/bundjil.git\",\n    \"directory\": \"packages/infrastructure\"\n  },\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n 