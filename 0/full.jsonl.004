{"timestamp":"2026-09-23T23:34:59.844Z","ordinal":89801,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019f3c64-2576-70c2-90c0-e6b212f79ee1","turn_id":"01a0d09d-47a5-7db3-b179-80b63f2ed88a","item":{"type":"CommandExecution","id":"exec-015572b1-57f6-4cec-bc9b-474de5fd347a","process_id":"11028","command":["/bin/zsh","-lc","sed -n '1,200p' .github/workflows/infrastructure-drift.yml"],"cwd":"file:///Users/cooper/Projects/bundjil","parsed_cmd":[{"type":"read","cmd":"sed -n '1,200p' .github/workflows/infrastructure-drift.yml","name":"infrastructure-drift.yml","path":".github/workflows/infrastructure-drift.yml"}],"source":"unified_exec_startup","status":"completed","stdout":"name: Infrastructure Drift\n\non:\n  pull_request:\n    branches: [main]\n  schedule:\n    - cron: \"17 3 * * 1\"\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: infrastructure-drift-${{ github.repository }}-${{ github.event.pull_request.number || github.ref }}\n  cancel-in-progress: true\n\njobs:\n  preview-report:\n    if: github.repository == 'crcorbett/bundjil' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    environment: infrastructure-read-only-preview\n    env:\n      BUNDJIL_INFRASTRUCTURE_DRIFT_ACCEPT_UNOWNED: \"false\"\n      BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_PATH: tmp/proof/infrastructure-drift.authority.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_RECEIPT_PATH: tmp/proof/infrastructure-drift.receipt.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_REPORT_PATH: tmp/proof/infrastructure-drift.report.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_RUN_IDENTITY: github-actions:${{ github.repository }}:${{ github.run_id }}:${{ github.run_attempt }}\n      BUNDJIL_INFRASTRUCTURE_DRIFT_SOURCE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n      BUNDJIL_INFRASTRUCTURE_DRIFT_STAGE: preview\n      BUNDJIL_INFRASTRUCTURE_MANIFEST_DIGEST: bb731f680e64422d198ed6fa88997a23dbf4f99f55ba743d36d10c954dff76f5\n      BUNDJIL_INFRASTRUCTURE_MANIFEST_PATH: tmp/proof/infrastructure-drift.manifest.json\n      BUNDJIL_INFRASTRUCTURE_MODE: sync\n      BUNDJIL_INFRASTRUCTURE_STAGE: preview\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node\n        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0\n        with:\n          node-version: \"24\"\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\n        with:\n          bun-version: \"1.3.14\"\n\n      - name: Install dependencies\n        run: bun install --frozen-lockfile\n\n      - name: Fetch bounded Preview drift inputs\n        id: doppler\n        uses: dopplerhq/secrets-fetch-action@451892f16195f9ac360e1a5bcbf0b5fd0e957534 # v2.0.0\n        with:\n          doppler-token: ${{ secrets.DOPPLER_TOKEN }}\n\n      - name: Prepare bounded read-only custody\n        env:\n          DRIFT_AUTHORITY_JSON: ${{ steps.doppler.outputs.BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_JSON }}\n          DRIFT_ENV_FILE: ${{ steps.doppler.outputs.BUNDJIL_INFRASTRUCTURE_DRIFT_ENV_FILE }}\n          DRIFT_MANIFEST_GZIP_BASE64: ${{ steps.doppler.outputs.BUNDJIL_INFRASTRUCTURE_DRIFT_MANIFEST_JSON }}\n        shell: bash\n        run: |\n          set -euo pipefail\n          test -n \"$DRIFT_AUTHORITY_JSON\"\n          test -n \"$DRIFT_ENV_FILE\"\n          test -n \"$DRIFT_MANIFEST_GZIP_BASE64\"\n          umask 077\n          mkdir -p tmp/proof\n          printf '%s' \"$DRIFT_AUTHORITY_JSON\" > \"$BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_PATH\"\n          printf '%s' \"$DRIFT_MANIFEST_GZIP_BASE64\" \\\n            | base64 --decode \\\n            | gzip --decompress \\\n            > \"$BUNDJIL_INFRASTRUCTURE_MANIFEST_PATH\"\n          printf '%s' \"$DRIFT_ENV_FILE\" > \"$RUNNER_TEMP/bundjil-infrastructure-drift.env\"\n          chmod 0600 \\\n            \"$BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_PATH\" \\\n            \"$BUNDJIL_INFRASTRUCTURE_MANIFEST_PATH\" \\\n            \"$RUNNER_TEMP/bundjil-infrastructure-drift.env\"\n\n      - name: Report Preview drift without repair\n        run: bun run --env-file \"$RUNNER_TEMP/bundjil-infrastructure-drift.env\" infrastructure:drift-report:internal\n\n      - name: Read back sanitised drift receipt\n        if: ${{ always() }}\n        shell: bash\n        run: |\n          set -euo pipefail\n          test -s \"$BUNDJIL_INFRASTRUCTURE_DRIFT_REPORT_PATH\"\n          test -s \"$BUNDJIL_INFRASTRUCTURE_DRIFT_RECEIPT_PATH\"\n          jq -c '{\n            schemaVersion,\n            status,\n            counts,\n            groupedFindings: (\n              [.findings[] | select(.disposition != \"accepted\")]\n              | sort_by(.resourceKind, .category, .disposition)\n              | group_by(.resourceKind, .category, .disposition)\n              | map({\n                  resourceKind: .[0].resourceKind,\n                  category: .[0].category,\n                  disposition: .[0].disposition,\n                  count: length\n                })\n            )\n          }' \"$BUNDJIL_INFRASTRUCTURE_DRIFT_REPORT_PATH\"\n          jq -c '.' \"$BUNDJIL_INFRASTRUCTURE_DRIFT_RECEIPT_PATH\"\n","stderr":"","aggregated_output":"name: Infrastructure Drift\n\non:\n  pull_request:\n    branches: [main]\n  schedule:\n    - cron: \"17 3 * * 1\"\n  workflow_dispatch:\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: infrastructure-drift-${{ github.repository }}-${{ github.event.pull_request.number || github.ref }}\n  cancel-in-progress: true\n\njobs:\n  preview-report:\n    if: github.repository == 'crcorbett/bundjil' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    environment: infrastructure-read-only-preview\n    env:\n      BUNDJIL_INFRASTRUCTURE_DRIFT_ACCEPT_UNOWNED: \"false\"\n      BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_PATH: tmp/proof/infrastructure-drift.authority.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_RECEIPT_PATH: tmp/proof/infrastructure-drift.receipt.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_REPORT_PATH: tmp/proof/infrastructure-drift.report.json\n      BUNDJIL_INFRASTRUCTURE_DRIFT_RUN_IDENTITY: github-actions:${{ github.repository }}:${{ github.run_id }}:${{ github.run_attempt }}\n      BUNDJIL_INFRASTRUCTURE_DRIFT_SOURCE_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n      BUNDJIL_INFRASTRUCTURE_DRIFT_STAGE: preview\n      BUNDJIL_INFRASTRUCTURE_MANIFEST_DIGEST: bb731f680e64422d198ed6fa88997a23dbf4f99f55ba743d36d10c954dff76f5\n      BUNDJIL_INFRASTRUCTURE_MANIFEST_PATH: tmp/proof/infrastructure-drift.manifest.json\n      BUNDJIL_INFRASTRUCTURE_MODE: sync\n      BUNDJIL_INFRASTRUCTURE_STAGE: preview\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Setup Node\n        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0\n        with:\n          node-version: \"24\"\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\n        with:\n          bun-version: \"1.3.14\"\n\n      - name: Install dependencies\n        run: bun install --frozen-lockfile\n\n      - name: Fetch bounded Preview drift inputs\n        id: doppler\n        uses: dopplerhq/secrets-fetch-action@451892f16195f9ac360e1a5bcbf0b5fd0e957534 # v2.0.0\n        with:\n          doppler-token: ${{ secrets.DOPPLER_TOKEN }}\n\n      - name: Prepare bounded read-only custody\n        env:\n          DRIFT_AUTHORITY_JSON: ${{ steps.doppler.outputs.BUNDJIL_INFRASTRUCTURE_DRIFT_AUTHORITY_JSON }}