\n    ok: findings.length === 0,\n    schemaVersion: 1,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0d09d-47a5-7db3-b179-80b63f2ed88a","create_time":1790206771.046754}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
