{"timestamp":"2026-09-23T23:34:23.574Z","ordinal":89736,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0d09e-ce56-7813-aa5e-d415b47c7cf2","call_id":"call_zwZaM5yFzQ9oRpR6qplV22I5","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import { adopt } from \"alchemy/AdoptPolicy\";\nimport * as Cloudflare from \"alchemy/Cloudflare\";\nimport * as Output from \"alchemy/Output\";\nimport { retain } from \"alchemy/RemovalPolicy\";\nimport { Effect, Option } from \"effect\";\n\nimport { declareSiteDashboards } from \"../axiom/dashboards\";\nimport {\n  previewStackOutput,\n  productionCanonicalDomainName,\n  productionRedirectDomainName,\n  productionStackOutput,\n  productionZoneName,\n  productionZoneResourceName,\n} from \"../cloudflare/stack\";\nimport {\n  cloudflareWebsiteResourceName,\n  cloudflareWebsiteViteOptions,\n} from \"../cloudflare/website\";\nimport { isProductionStage } from \"../observability/plan\";\nimport type { ObservabilityExportPlan } from \"../observability/schemas\";\nimport type { SiteDeploymentSha } from \"../schemas\";\nimport { declareSiteObservability } from \"./observability\";\n\nexport const declareSiteStack = ({\n  deploymentSha,\n  plan,\n  stackName,\n}: {\n  readonly deploymentSha: SiteDeploymentSha;\n  readonly plan: ObservabilityExportPlan;\n  readonly stackName: string;\n}) =>\n  Effect.gen(function* () {\n    const { metricsConfigSecret } = yield* declareSiteObservability({\n      deploymentSha,\n      plan,\n    });\n    const exportPlan = Option.some(plan);\n    const production = isProductionStage(plan.stage);\n    const zone = production\n      ? yield* Cloudflare.Zone.Zone(productionZoneResourceName, {\n          name: productionZoneName,\n        }).pipe(adopt(true), retain())\n      : undefined;\n    yield* Option.match(Option.fromUndefinedOr(zone), {\n      onNone: () => Effect.void,\n      onSome: (productionZone) =>\n        Effect.gen(function* () {\n          yield* Cloudflare.Zone.Setting(\"CooperCorbettTls13\", {\n            zoneId: productionZone.zoneId,\n            settingId: \"tls_1_3\",\n            value: \"on\",\n          }).pipe(retain());\n          yield* Cloudflare.Zone.Setting(\"CooperCorbettMinimumTlsVersion\", {\n            zoneId: productionZone.zoneId,\n            settingId: \"min_tls_version\",\n            value: \"1.3\",\n          }).pipe(retain());\n          yield* Cloudflare.DNS.Dnssec(\"CooperCorbettDnssec\", {\n            zoneId: productionZone.zoneId,\n            status: \"active\",\n          }).pipe(retain());\n        }),\n    });\n    const websiteOptionsBase = {\n      ...cloudflareWebsiteViteOptions(exportPlan),\n      env: {\n        SITE_AXIOM_METRICS_CONFIG: metricsConfigSecret,\n        SITE_DEPLOYMENT_SHA: deploymentSha,\n      },\n    };\n    const websiteOptions = Option.fromUndefinedOr(zone).pipe(\n      Option.match({\n        onNone: () => websiteOptionsBase,\n        onSome: (productionZone) => ({\n          ...websiteOptionsBase,\n          domain: {\n            name: productionCanonicalDomainName,\n            redirects: [productionRedirectDomainName],\n            zone: productionZone,\n          },\n        }),\n      })\n    );\n    const website = yield* Cloudflare.Website.Vite(\n      cloudflareWebsiteResourceName,\n      websiteOptions\n    );\n\n    if (!production) {\n      return previewStackOutput({\n        stackName,\n        stage: plan.stage,\n        websiteUrl: website.url,\n      });\n    }\n\n    const dashboardDeploymentIdentity = Output.all(\n      Output.literal(deploymentSha),\n      website.workerName\n    ).pipe(\n      Output.map(([revision, workerName]) => ({\n        deploymentSha: revision,\n        workerName,\n      }))\n    );\n    yield* declareSiteDashboards(plan, dashboardDeploymentIdentity);\n\n    return productionStackOutput({\n      stackName,\n      stage: plan.stage,\n      websiteUrl: website.url,\n    });\n  });\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0d09d-47a5-7db3-b179-80b63f2ed88a","create_time":1790206463.574341}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
