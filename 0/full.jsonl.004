{"timestamp":"2026-09-23T23:49:46.109Z","ordinal":90530,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019f3c64-2576-70c2-90c0-e6b212f79ee1","turn_id":"01a0d09d-47a5-7db3-b179-80b63f2ed88a","item":{"type":"CommandExecution","id":"exec-b7d85653-61fc-441e-a880-579634480d15","process_id":"13637","command":["/bin/zsh","-lc","git show origin/main:alchemy.run.ts"],"cwd":"file:///Users/cooper/Projects/site","parsed_cmd":[{"type":"unknown","cmd":"git show origin/main:alchemy.run.ts"}],"source":"unified_exec_startup","status":"completed","stdout":"import {\n  ObservabilityStage,\n  observabilityExportPlanForStage,\n} from \"@packages/infrastructure/observability\";\nimport { SiteDeploymentSha } from \"@packages/infrastructure/schemas\";\nimport {\n  cloudflareStackName,\n  declareSiteStack,\n} from \"@packages/infrastructure/stack\";\nimport * as Alchemy from \"alchemy\";\nimport * as Axiom from \"alchemy/Axiom\";\nimport * as Cloudflare from \"alchemy/Cloudflare\";\nimport { Stack } from \"alchemy/Stack\";\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\nimport * as Schema from \"effect/Schema\";\n\nconst siteProviders = Cloudflare.providers().pipe(\n  Layer.provideMerge(Axiom.providers())\n);\n\nexport default Alchemy.Stack(\n  cloudflareStackName,\n  {\n    providers: siteProviders,\n    state: Cloudflare.state(),\n  },\n  Effect.gen(function* () {\n    const stack = yield* Stack;\n    const stage = yield* Schema.decodeEffect(ObservabilityStage)(\n      stack.stage\n    ).pipe(Effect.orDie);\n    const deploymentSha = yield* Config.schema(SiteDeploymentSha, \"GITHUB_SHA\");\n    return yield* declareSiteStack({\n      deploymentSha,\n      plan: observabilityExportPlanForStage(stage),\n      stackName: stack.name,\n    });\n  })\n);\n","stderr":"","aggregated_output":"import {\n  ObservabilityStage,\n  observabilityExportPlanForStage,\n} from \"@packages/infrastructure/observability\";\nimport { SiteDeploymentSha } from \"@packages/infrastructure/schemas\";\nimport {\n  cloudflareStackName,\n  declareSiteStack,\n} from \"@packages/infrastructure/stack\";\nimport * as Alchemy from \"alchemy\";\nimport * as Axiom from \"alchemy/Axiom\";\nimport * as Cloudflare from \"alchemy/Cloudflare\";\nimport { Stack } from \"alchemy/Stack\";\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\nimport * as Schema from \"effect/Schema\";\n\nconst siteProviders = Cloudflare.providers().pipe(\n  Layer.provideMerge(Axiom.providers())\n);\n\nexport default Alchemy.Stack(\n  cloudflareStackName,\n  {\n    providers: siteProviders,\n    state: Cloudflare.state(),\n  },\n  Effect.gen(function* () {\n    const stack = yield* Stack;\n    const stage = yield* Schema.decodeEffect(ObservabilityStage)(\n      stack.stage\n    ).pipe(Effect.orDie);\n    const deploymentSha = yield* Config.schema(SiteDeploymentSha, \"GITHUB_SHA\");\n    return yield* declareSiteStack({\n      deploymentSha,\n      plan: observabilityExportPlanForStage(stage),\n      stackName: stack.name,\n    });\n  })\n);\n","exit_code":0,"duration":{"secs":0,"nanos":10333},"formatted_output":"import {\n  ObservabilityStage,\n  observabilityExportPlanForStage,\n} from \"@packages/infrastructure/observability\";\nimport { SiteDeploymentSha } from \"@packages/infrastructure/schemas\";\nimport {\n  cloudflareStackName,\n  declareSiteStack,\n} from \"@packages/infrastructure/stack\";\nimport * as Alchemy from \"alchemy\";\nimport * as Axiom from \"alchemy/Axiom\";\nimport * as Cloudflare from \"alchemy/Cloudflare\";\nimport { Stack } from \"alchemy/Stack\";\nimport * as Config from \"effect/Config\";\nimport * as Effect from \"effect/Effect\";\nimport * as Layer from \"effect/Layer\";\nimport * as Schema from \"effect/Schema\";\n\nconst siteProviders = Cloudflare.providers().pipe(\n  Layer.provideMerge(Axiom.providers())\n);\n\nexport default Alchemy.Stack(\n  cloudflareStackName,\n  {\n    providers: siteProviders,\n    state: Cloudflare.state(),\n  },\n  Effect.gen(function* () {\n    const stack = yield* Stack;\n    const stage = yield* Schema.decodeEffect(ObservabilityStage)(\n      stack.stage\n    ).pipe(Effect.orDie);\n    const deploymentSha = yield* Config.schema(SiteDeploymentSha, \"GITHUB_SHA\");\n    return yield* declareSiteStack({\n      deploymentSha,\n      plan: observabilityExportPlanForStage(stage),\n      stackName: stack.name,\n    });\n  })\n);\n"},"started_at_ms":1790207386109,"completed_at_ms":1790207386109}}
