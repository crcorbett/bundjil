pe DiscoverVercelProjectEncoded,\n  ListedVercelDeployments,\n  type ListedVercelDeploymentsEncoded,\n  ListedVercelEnvironmentVariables,\n  type ListedVercelEnvironmentVariablesEncoded,\n  ListedVercelMarketplaceBindings,\n  type ListedVercelMarketplaceBindingsEncoded,\n  ListedVercelProjectDomains,\n  type ListedVercelProjectDomainsEncoded,\n  ListedVercelProjects,\n  type ListedVercelProjectsEncoded,\n  ListVercelDeployments,\n  type ListVercelDeploymentsEncoded,\n  ListVercelEnvironmentVariables,\n  type ListVercelEnvironmentVariablesEncoded,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0d09d-47a5-7db3-b179-80b63f2ed88a","create_time":1790206645.735417}},"metadata":{"client_authored":false,"fallback_token_limit_override":12000}}
