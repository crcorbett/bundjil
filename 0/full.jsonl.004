a from \"effect/Schema\";\n\nconst siteProviders = Cloudflare.providers().pipe(\n  Layer.provideMerge(Axiom.providers())\n);\n\nexport default Alchemy.Stack(\n  cloudflareStackName,\n  {\n    providers: siteProviders,\n    state: Cloudflare.state(),\n  },\n  Effect.gen(function* () {\n    const stack = yield* Stack;\n    const stage = yield* Schema.decodeEffect(ObservabilityStage)(\n      stack.stage\n    ).pipe(Effect.orDie);\n    const deploymentSha = yield* Config.schema(SiteDeploymentSha, \"GITHUB_SHA\");\n    return yield* declareSiteStack({\n      deploymentSha,\n      plan: observabilityExportPlanForStage(stage),\n      stackName: stack.name,\n    });\n  })\n);\n"},"started_at_ms":1790206457846,"completed_at_ms":1790206457846}}
