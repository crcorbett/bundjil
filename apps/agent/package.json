{
  "name": "@bundjil/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Vercel Eve app for the Bundjil personal agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcorbett/bundjil.git",
    "directory": "apps/agent"
  },
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "dev:no-ui": "eve dev --no-ui",
    "build": "eve build --skip-sandbox-prewarm",
    "check-types": "tsc --noEmit",
    "preflight:production": "bun scripts/production-preflight.ts",
    "test": "vitest run",
    "build:vercel": "VERCEL=1 eve build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.75",
    "@bundjil/channel": "workspace:*",
    "@bundjil/eve": "workspace:*",
    "@bundjil/photon": "workspace:*",
    "@bundjil/sendblue": "workspace:*",
    "@bundjil/store": "workspace:*",
    "@effect/platform-bun": "catalog:effect",
    "@opentelemetry/api": "1.10.0",
    "@vercel/otel": "2.1.3",
    "ai": "7.0.148",
    "effect": "catalog:effect",
    "eve": "0.82.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@types/bun": "1.4.3",
    "jose": "6.2.13",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
