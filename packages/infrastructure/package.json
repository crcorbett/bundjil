{
  "name": "@bundjil/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Private Alchemy infrastructure contracts and providers for Bundjil.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcorbett/bundjil.git",
    "directory": "packages/infrastructure"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@bundjil/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@bundjil/source": "./src/__testing__/fixtures.ts",
      "types": "./dist/__testing__/fixtures.d.ts",
      "default": "./dist/__testing__/fixtures.js"
    },
    "./vercel": {
      "@bundjil/source": "./src/vercel/index.ts",
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./photon": {
      "@bundjil/source": "./src/photon/index.ts",
      "types": "./dist/photon/index.d.ts",
      "default": "./dist/photon/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "adoption:manifest": "bun --conditions=@bundjil/source run scripts/generate-adoption-manifest.ts",
    "adoption:proof": "bun --conditions=@bundjil/source run scripts/prove-adoption-state.ts",
    "inventory:live": "bun --conditions=@bundjil/source run scripts/inventory-live.ts",
    "preview:drift": "bun --conditions=@bundjil/source run scripts/preview-configuration-drift.ts",
    "test": "vitest run && bun --conditions=@bundjil/source test test-alchemy"
  },
  "dependencies": {
    "@bundjil/photon": "workspace:*",
    "@distilled.cloud/aws": "0.30.1",
    "@effect/platform-bun": "catalog:effect",
    "ajv": "^8.17.1",
    "alchemy": "2.0.0-beta.64",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@types/bun": "^1.3.14",
    "bun-types": "1.3.14",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
