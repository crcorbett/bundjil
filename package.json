{
  "name": "bundjil",
  "private": true,
  "description": "Personal agent workspace for Vercel Eve, iMessage, email, and connected tools.",
  "keywords": [
    "agent",
    "effect",
    "eve",
    "imessage",
    "sendblue",
    "vercel"
  ],
  "homepage": "https://github.com/crcorbett/bundjil#readme",
  "bugs": {
    "url": "https://github.com/crcorbett/bundjil/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcorbett/bundjil.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "typescript": {
        "typescript": "^6.0.3"
      },
      "effect": {
        "effect": "^4.0.0-beta.100",
        "@effect/platform-bun": "4.0.0-beta.100",
        "@effect/platform-node": "4.0.0-beta.100",
        "@effect/vitest": "^4.0.0-beta.100",
        "@effect/language-service": "^0.86.4"
      },
      "testing": {
        "vitest": "^4.1.7"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "bun run check:effect-setup && turbo run build",
    "check-types": "bun run check:effect-setup && turbo run check-types",
    "check:boundaries": "bun run check:effect-setup && tsc --project tooling/tsconfig.json && bun tooling/boundary-audit.ts",
    "check:effect-setup": "effect-language-service check",
    "check:docs": "bun tooling/documentation-policy-audit.ts",
    "check:skills": "bun tooling/skill-policy-audit.ts",
    "check:authority": "bun tooling/authority-policy-audit.ts",
    "check:controls": "bun tooling/control-policy-audit.ts",
    "check:verification": "bun tooling/verification-policy-audit.ts",
    "eval:hgi-307": "bun tooling/evals/harness-evaluation-audit.ts",
    "fix": "ultracite fix --type-aware",
    "check": "ultracite check --type-aware",
    "verification": "bun run check:effect-setup && bun run check:boundaries && bun run check:docs && bun run check:skills && bun run check:authority && bun run check:controls && bun run check:verification && bun run eval:hgi-307 && bun run test:boundaries && bun run check && bun run test:lint && bun run knip && bun run check-types && bun run test",
    "eve": "eve",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "prepare": "effect-language-service patch",
    "test": "turbo run test",
    "test:lint": "vitest run --config lint/vitest.config.ts",
    "test:boundaries": "vitest run --config tooling/vitest.config.ts",
    "test:controls": "vitest run --config tooling/vitest.config.ts tooling/control-policy.test.ts",
    "test:harness": "vitest run --config tooling/vitest.config.ts tooling/evals/harness-evaluation.test.ts",
    "knip": "knip",
    "infrastructure:adoption-manifest": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/generate-adoption-manifest.ts",
    "infrastructure:adoption-proof": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/prove-adoption-state.ts",
    "infrastructure:inventory": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/inventory-live.ts",
    "infrastructure:preview-state-migration": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/migrate-state.ts",
    "infrastructure:production-state-migration": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/migrate-state.ts",
    "infrastructure:preview-plan": "bun alchemy deploy alchemy.preview.run.ts --stage preview --env-file .env.local --dry-run --adopt --yes",
    "infrastructure:preview-apply": "bun alchemy deploy alchemy.preview.run.ts --stage preview --env-file .env.local --adopt --yes",
    "infrastructure:preview-sync": "bun alchemy sync alchemy.preview.run.ts --stage preview --env-file .env.local --dry-run --yes",
    "infrastructure:preview-repair": "bun alchemy sync alchemy.preview.run.ts --stage preview --env-file .env.local --yes",
    "infrastructure:preview-drift": "bun --env-file=.env.local --conditions=@bundjil/source run packages/infrastructure/scripts/preview-configuration-drift.ts",
    "infrastructure:preview-rollback-plan": "BUNDJIL_PREVIEW_CONFIGURATION_PHASE=rollback bun alchemy deploy alchemy.preview.run.ts --stage preview --env-file .env.local --dry-run --yes",
    "infrastructure:preview-rollback": "BUNDJIL_PREVIEW_CONFIGURATION_PHASE=rollback bun alchemy deploy alchemy.preview.run.ts --stage preview --env-file .env.local --yes",
    "infrastructure:stable-preview-plan": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=preview BUNDJIL_INFRASTRUCTURE_MODE=plan bun alchemy deploy alchemy.stable.run.ts --stage preview --env-file .env.local --dry-run --yes",
    "infrastructure:stable-preview-apply": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=preview BUNDJIL_INFRASTRUCTURE_MODE=apply bun alchemy deploy alchemy.stable.run.ts --stage preview --env-file .env.local --yes",
    "infrastructure:stable-preview-sync": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=preview BUNDJIL_INFRASTRUCTURE_MODE=sync bun alchemy sync alchemy.stable.run.ts --stage preview --env-file .env.local --dry-run --yes",
    "infrastructure:stable-production-plan": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=prod BUNDJIL_INFRASTRUCTURE_MODE=plan bun alchemy deploy alchemy.stable.run.ts --stage prod --env-file .env.local --dry-run --yes",
    "infrastructure:stable-production-apply": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=prod BUNDJIL_INFRASTRUCTURE_MODE=apply bun alchemy deploy alchemy.stable.run.ts --stage prod --env-file .env.local --yes",
    "infrastructure:stable-production-sync": "bun run --filter @bundjil/infrastructure build && BUNDJIL_INFRASTRUCTURE_STAGE=prod BUNDJIL_INFRASTRUCTURE_MODE=sync bun alchemy sync alchemy.stable.run.ts --stage prod --env-file .env.local --dry-run --yes",
    "infrastructure:photon-candidate-inventory": "bun --env-file=.env.local run --filter @bundjil/photon inventory:candidates",
    "infrastructure:photon-preview-webhook-register": "bun --env-file=.env.local run --filter @bundjil/photon register:environment-webhook",
    "infrastructure:photon-production-webhook-register": "BUNDJIL_PHOTON_WEBHOOK_STAGE=prod bun --env-file=.env.local run --filter @bundjil/photon register:environment-webhook",
    "infrastructure:photon-production-webhook-delete": "BUNDJIL_PHOTON_WEBHOOK_STAGE=prod bun --env-file=.env.local run --filter @bundjil/photon delete:environment-webhook",
    "infrastructure:photon-preview-webhook-binding": "bun --env-file=.env.local run --filter @bundjil/infrastructure photon:bind-preview-webhook",
    "infrastructure:vercel-git-link-authority": "bun --conditions=@bundjil/source run packages/infrastructure/scripts/validate-vercel-git-link-authority.ts"
  },
  "devDependencies": {
    "@bundjil/infrastructure": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@types/bun": "^1.3.14",
    "alchemy": "2.0.0-beta.64",
    "effect": "catalog:effect",
    "eve": "0.20.0",
    "knip": "^6.6.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "turbo": "^2.9.6",
    "typescript": "catalog:typescript",
    "ultracite": "7.6.1",
    "vitest": "catalog:testing",
    "yaml": "^2.9.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.3.14"
}
