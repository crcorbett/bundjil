{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts",
        "stacks/**/*.ts",
        "tooling/codec-provenance.fixture.ts"
      ],
      "project": ["stacks/**/*.ts", "tooling/**/*.ts"]
    },
    "apps/agent": {
      "entry": [
        "agent/agent.ts",
        "agent/instrumentation.ts",
        "agent/channels/**/*.ts",
        "agent/tools/**/*.ts",
        "test/**/*.test.ts"
      ],
      "project": ["agent/**/*.ts", "test/**/*.ts"]
    },
    "apps/codex-proxy": {
      "entry": ["api/**/*.ts", "scripts/**/*.ts", "test/**/*.test.ts"],
      "project": [
        "api/**/*.ts",
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/photon": {
      "ignoreDependencies": ["@grpc/grpc-js", "nice-grpc", "nice-grpc-common"]
    },
    "packages/infrastructure": {
      "entry": [
        "test/**/*.compile.ts",
        "test/**/*.test.ts",
        "test-alchemy/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "test-alchemy/**/*.ts"]
    }
  }
}
