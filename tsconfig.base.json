{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-bun/BunFileSystem",
          "@effect/platform-bun/BunHttpServer",
          "@effect/platform-bun/BunServices",
          "effect/ByteSize",
          "effect/FileSystem",
          "effect/Path",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientError",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpRouter",
          "effect/http/HttpServer",
          "effect/http/HttpServerError",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/http/UrlParams",
          "effect/net/NetAddress",
          "effect/persistence/KeyValueStore",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner"
        ],
        "overrides": [
          {
            "include": ["**/test/**/*.ts", "**/test-alchemy/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "@effect/platform-bun/BunFileSystem",
                "@effect/platform-bun/BunHttpServer",
                "@effect/platform-bun/BunServices",
                "@effect/vitest",
                "effect/ByteSize",
                "effect/FileSystem",
                "effect/Path",
                "effect/http/FetchHttpClient",
                "effect/http/HttpClient",
                "effect/http/HttpClientError",
                "effect/http/HttpClientRequest",
                "effect/http/HttpClientResponse",
                "effect/http/HttpRouter",
                "effect/http/HttpServer",
                "effect/http/HttpServerError",
                "effect/http/HttpServerRequest",
                "effect/http/HttpServerResponse",
                "effect/http/UrlParams",
                "effect/net/NetAddress",
                "effect/persistence/KeyValueStore",
                "effect/process/ChildProcess",
                "effect/process/ChildProcessSpawner"
              ]
            }
          }
        ],
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "floatingEffect": "error",
          "globalFetchInEffect": "error",
          "nestedEffectGenYield": "error",
          "newPromise": "error",
          "preferSchemaOverJson": "error",
          "processEnv": "error",
          "processEnvInEffect": "error",
          "schemaSyncInEffect": "error",
          "unknownInEffectCatch": "error",
          "unsafeEffectTypeAssertion": "error"
        }
      }
    ],
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "incremental": true,

    // Strict type checking
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    // Code quality
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Module handling
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",

    // Build output
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "outDir": "${configDir}/dist",

    // Monorepo live types
    "customConditions": ["@bundjil/source"]
  },
  "exclude": ["${configDir}/dist", "${configDir}/node_modules"]
}
